Plecs {
  Name          "carregador"
  Version       "5.0"
  CircuitModel  "ContStateSpace"
  StartTime     "0.0"
  TimeSpan      "1.0"
  Timeout       ""
  Solver        "auto"
  MaxStep       "2e-6"
  InitStep      "-1"
  FixedStep     "1e-3"
  Refine        "1"
  ZCStepSize    "1e-9"
  RelTol        "1e-4"
  AbsTol        "-1"
  TurnOnThreshold "0"
  NonIdealSwitchResistance "1"
  SyncFixedStepTasks "2"
  UseSingleCommonBaseRate "2"
  LossVariableLimitExceededMsg "3"
  NegativeSwitchLossMsg "3"
  DivisionByZeroMsg "3"
  DatatypeOverflowMsg "3"
  DatatypeInheritanceConflictMsg "2"
  ContSampleTimeConflictMsg "2"
  StiffnessDetectionMsg "2"
  MaxConsecutiveZCs "1000"
  AlgebraicLoopWithStateMachineMsg "3"
  AssertionAction "1"
  FixedPointDatatypeOverride "1"
  InitializationCommands "% ================= CARREGADOR DE BATERIAS DE 15 A - FORWARD DE DUAS CHAVES =================\n% ---- as duas variaveis que definem o ensaio\nVrede  = 176;     % tensao eficaz da rede (V): 176 = minima, 220 = nominal, 264 = maxima\nensaio = 1;       % 0 = regime a 100 %; 1 = degrau de carga 100 % <-> 20 %; 2 = curto-circuito;\n                  % 3 = recarga da bateria\n% ---- rede e retificador com filtro capacitivo\nfr  = 60;\nVpk = sqrt(2)*Vrede;\nC1  = 940e-6;     % 2 x 470 uF/450 V (planilha); o esquematico do professor mostra 470 uF\nVd  = 0.7;        % queda dos diodos, como no PSIM\nRd  = 5e-3;       % resistencia de conducao dos diodos da ponte: o PLECS nao aceita fonte ideal\n                  % em paralelo com C1 atraves de chaves ideais (no PSIM o professor usou 0)\n% ---- Forward de duas chaves\nfs = 50e3;  Np = 100;  Ns = 30;  Lm = 20e-3;\nLk = 0.1e-6 + 0.1e-6*(Ns/Np)^2;   % dispersao do PSIM (0,1 uH por enrolamento), referida ao secundario\nLo = 136.6e-6;  Co = 2200e-6;  Rse = 0.11;  Rsh = 0.01;\n% ---- saida, carga e bateria\nVo = 27;  Io = 15;  Ro = Vo/Io;\nf_carga = 3;      % comutacao da carga (Hz), razao ciclica 0,5; comeca ligada\nR9 = 5*Ro;  R10 = 1.25*Ro;  hab_carga = 1;  hab_bat = 0;      % ensaio 1: 20 % fixo + 80 % comutado\nif ensaio == 0, R9 = Ro;  R10 = 1e6; hab_carga = 0; end        % carga nominal fixa\nif ensaio == 2, R9 = Ro;  R10 = 1e-3; end                      % curto-circuito de 1 mOhm\nif ensaio == 3, R9 = 1e6; R10 = 1e6; hab_carga = 0; hab_bat = 1; end\nVbat0 = 20;  Rbat = 10e-3;\nCbat  = 0.8;      % emula o tempo de recarga (0,8 F reproduz a Fig. 17; o esquematico mostra 400 mF)\n% ---- controle\nVrefv = 2.5;      % referencia de tensao (27 V na saida)\nVrefi = 2.5;      % referencia de corrente: 0 a 2,5 V ajusta a recarga de 0 a 15 A\nR11 = 100e3;  R12 = 10.2e3;                           % divisor da tensao de saida\nR13 = 10e3;  R14 = 82e3;  C5 = 1.5e-9;  C6 = 100e-12; % compensador de tensao (tipo 2)\nR2 = 10e3;  R3 = 10e3;  R4 = 167e3;  R5 = 167e3;      % amplificador diferencial do shunt\nR16 = 10e3;  R18 = 18e3;  C7 = 2.7e-9;  C8 = 220e-12; % compensador de corrente (tipo 2)\nR7 = 1e3;  Rpd = 100e3;  Vd6 = 0.5;\nVtri_min = 0.8;  Vtri_max = 3.2;                      % portadora triangular (2,4 V pico a pico)\nDmax = 0.48;  Vz = Vtri_min + Dmax*(Vtri_max - Vtri_min);   % grampo da tensao de controle\nAop = 1e5;  Vsat = [0 5];                             % amplificadores operacionais\n% ---- condicoes iniciais\nVC1_0 = Vpk - 2*Vd;  VCo_0 = 0;\n"
  InitialState  "1"
  SystemState   ""
  JacobianComputation "2"
  TaskingMode   "1"
  TaskConfigurations ""
  CodeGenParameterInlining "2"
  CodeGenFloatingPointFormat "2"
  CodeGenAbsTimeUsageMsg "3"
  CodeGenBaseName ""
  CodeGenOutputDir ""
  CodeGenExtraOpts ""
  CodeGenTarget "Generic"
  CodeGenTargetSettings ""
  ExtendedMatrixPrecision "1"
  MatrixSignificanceCheck "2"
  RemoveUnusedStateSpaceOutputs "2"
  EnableStateSpaceSplitting "2"
  DisplayStateSpaceSplitting "1"
  DiscretizationMethod "2"
  ExternalModeSettings ""
  AlgebraicLoopMethod "1"
  AlgebraicLoopTolerance "1e-6"
  ScriptsDialogGeometry ""
  ScriptsDialogSplitterPos "0"
  MixedSignalSolverBypassOperatingPoint "1"
  MixedSignalSolverInitialConditions "2"
  MixedSignalSolverMaxNewtonIterations "25"
  MixedSignalSolverNumThreads "-1"
  OperatingPointMaxNewtonIterations "50"
  OperatingPointRelativeNewtonTolerance "1e-3"
  OperatingPointAbsoluteNewtonTolerance "1e-12"
  OperatingPointNodalVoltageNewtonTolerance "1e-6"
  SpiceTemperature "27"
  SpiceGMin     "0"
  SpiceInductorRPar "0"
  SpiceInductorRSer "0"
  SpiceCapacitorGPar "0"
  SpiceCapacitorRSer "0"
