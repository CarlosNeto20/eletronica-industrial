  AlgebraicLoopWithStateMachineMsg "3"
  AssertionAction "1"
  FixedPointDatatypeOverride "1"
  InitializationCommands "% ---- Ponte completa (enunciado, secao 2.3)\nPo = 5"
"000;  Vi = 400;  Vo = 54;  fs = 20e3;  D = 0.4;\na  = Vo/(Vi*2*D);          %"
" 0.16875 = Ns/Np\nNp = 100;  Ns = Np*a;      % o professor usou 17\nLo  = 14."
"58e-6;\nCo  = 214.4e-6;  Rse = 0.015;     % Rse = Rc do enunciado\nLm  = 2.6e"
"-3;              % valor do enunciado (ver divergencia 1 do doc 00)\nRo  = Vo"
"^2/Po;\nR20 = 5*Ro;  R80 = 1.25*Ro;\nf_carga = 5;               % degraus: 0."
"1/0.3 s (100->20 %) e 0.2 s (20->100 %)\n% ---- Buck equivalente\nVi_eq = a*V"
"i;  L_eq = Lo;  fs_eq = 2*fs;  D_eq = 2*D;\n% ---- condicoes iniciais (regime"
" a 100 %)\nIL0 = Po/Vo;  IL_eq0 = IL0;  VC0 = Vo;\n"
  InitialState  "1"
  SystemState   ""
  JacobianComputation "2"
  TaskingMode   "1"
  TaskConfigurations ""
  CodeGenParameterInlining "2"
  CodeGenFloatingPointFormat "2"
  CodeGenAbsTimeUsageMsg "3"
  CodeGenBaseName ""
  CodeGenOutputDir ""
  CodeGenExtraOpts ""
  CodeGenTarget "Generic"
  CodeGenTargetSettings ""
  ExtendedMatrixPrecision "1"
