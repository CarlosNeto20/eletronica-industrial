    Component { Type TriangleGenerator Name "Serra_S2" Show on Position [2560, 3340] Direction right Flipped off LabelPosition south Parameter { Variable "Min" Value "0" Show off } Parameter { Variable "Max" Value "1" Show off } Parameter { Variable "f" Value "fsb" Show off } Parameter { Variable "DutyCycle" Value "1" Show off } Parameter { Variable "Delay" Value "0.5/fsb" Show off } }
