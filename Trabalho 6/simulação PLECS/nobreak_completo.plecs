  FixedPointDatatypeOverride "1"
  InitializationCommands "% Trabalho 6 - no-break de dupla conversao 3 kVA. Gerado por gerar_modelos.py; unidades SI.\nfs=20000; fsb=20000; fr=60; fo=60;\nLo=0.0003656; Co=6e-05; ESR_Co=0.005; Ro=6.297619048;\nR3k=3.085833333; L3k=0.008350806014; nl_Rs=0.2; nl_C=0.00188; nl_ESR=0.05; nl_R=9.5;\nC4=0.00188; ESR_C4=0.05; Rbus=0.1; R_T1=0.002;\nVf_ponte=0.8; Ron_ponte=0.01; Vf_rapido=0.8; Ron_rapido=0.005;\nRon_inv=0.05; Ron_cc=0.01; Lb=3.92e-05; C7=1e-05; C8=1e-05;\nT32_Lm=0.01; T32_Llk=1e-06; T32_R=0.001;\nHv=0.02459501848; Vd=5; Vref_pk=4; Vsat=5;\nKc=40310117.83; wz1=6109.978476; wz2=6109.978476; wp1=287168.9884; wp2=287168.9884;\nRsn=33; Csn=1e-09;\n% Variaveis de cenario (sobrescritas por ModelVars):\nVrms=220; phi_rede=0; Vcc=373.352; carga=1; Rres=6.297619; tcarga=0;\ntfalta=10; tretorno=100; tdet=0; modo_cc=0; Vbat=42; Db=0.7; Rcarga=19.6;\nVbus0=310; VC8_0=206; VC7_0=103; ILb0=0; VC3_0=140; Tstop=0.2;\n"
  InitialState  "1"
  SystemState   ""
  JacobianComputation "2"
  TaskingMode   "1"
  TaskConfigurations ""
  CodeGenParameterInlining "2"
  CodeGenFloatingPointFormat "2"
