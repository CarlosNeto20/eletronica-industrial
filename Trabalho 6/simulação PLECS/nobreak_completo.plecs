    Component { Type Resistor Name "R_nl" Show on Position [3030, 290] Direction up Flipped off LabelPosition south Parameter { Variable "R" Value "nl_R" Show off } }
    Component { Type Voltmeter Name "Vm_nl" Show on Position [3130, 290] Direction up Flipped off LabelPosition south  }
    Component { Type CScript Name "Controle" Show on Position [2400, 2770] Direction right Flipped off LabelPosition south Parameter { Variable "NumInputs" Value "1" Show off } Parameter { Variable "NumOutputs" Value "[1 1 1 1 1 1 1 1]" Show off } Parameter { Variable "NumContStates" Value "3" Show off } Parameter { Variable "NumDiscStates" Value "0" Show off } Parameter { Variable "NumZCSignals" Value "6" Show off } Parameter { Variable "DirectFeedthrough" Value "0" Show off } Parameter { Variable "Ts" Value "0" Show off } Parameter { Variable "Parameters" Value "Hv,Kc,wz1,wz2,wp1,wp2,Vref_pk,2*pi*fo,Vsat,tfalta,tretorno,modo_cc,tdet,Db,carga,tcarga" Show off } Parameter { Variable "LangStandard" Value "2" Show off } Parameter { Variable "GnuExtensions" Value "2" Show off } Parameter { Variable "RuntimeCheck" Value "2" Show off } Parameter { Variable "Declarations" Value "#include <math.h>\n/* Compensador Tipo 3 da planilha: Cv(s) = Kc (s+wz1)(s+wz2) / (s (s+wp1)(s+wp2)).\n   Estados em volts: x0 = Kc*integral(e); x1 e x2 = filtros dos dois avancos. */\n#define HV      ParamRealData(0,0)\n#define KC      ParamRealData(1,0)\n#define WZ1     ParamRealData(2,0)\n#define WZ2     ParamRealData(3,0)\n#define WP1     ParamRealData(4,0)\n#define WP2     ParamRealData(5,0)\n#define VREFPK  ParamRealData(6,0)\n#define WO      ParamRealData(7,0)\n#define VSAT    ParamRealData(8,0)\n#define TFALTA  ParamRealData(9,0)\n#define TRET    ParamRealData(10,0)\n#define MODOCC  ParamRealData(11,0)\n#define TDET    ParamRealData(12,0)\n#define DB      ParamRealData(13,0)\n#define CARGA   ParamRealData(14,0)\n#define TCARGA  ParamRealData(15,0)\n#define Y1 (ContState(0))\n#define Y2 (Y1 + (WZ1/WP1 - 1.0)*ContState(1))\n#define Y3 (Y2 + (WZ2/WP2 - 1.0)*ContState(2))\n#define VREF (VREFPK*sin(WO*CurrentTime))\nstatic double limita(double u, double l) { return u > l ? l : (u < -l ? -l : u); }\n" Show off } Parameter { Variable "StartFcn" Value "ContState(0) = 0.0;\nContState(1) = 0.0;\nContState(2) = 0.0;" Show off } Parameter { Variable "OutputFcn" Value "double t = CurrentTime;\ndouble u = Y3;\nint rede = (t < TFALTA) || (t >= TRET);\nint cc = (MODOCC > 0.5) ? 1 : ((t >= TFALTA + TDET) && (t < TRET));\nint liga = (t >= TCARGA);\nOutputSignal(0,0) = limita(u, VSAT);\nOutputSignal(1,0) = VREF;\nOutputSignal(2,0) = rede ? 1.0 : 0.0;\nOutputSignal(3,0) = cc ? DB : -1.0;\nOutputSignal(4,0) = (liga && fabs(CARGA - 1.0) < 0.5) ? 1.0 : 0.0;\nOutputSignal(5,0) = (liga && fabs(CARGA - 2.0) < 0.5) ? 1.0 : 0.0;\nOutputSignal(6,0) = (liga && fabs(CARGA - 3.0) < 0.5) ? 1.0 : 0.0;\nOutputSignal(7,0) = u;\nZCSignal(0) = t - TFALTA;\nZCSignal(1) = t - TRET;\nZCSignal(2) = t - TFALTA - TDET;\nZCSignal(3) = t - TCARGA;\nZCSignal(4) = u - VSAT;\nZCSignal(5) = u + VSAT;" Show off } Parameter { Variable "DerivativeFcn" Value "double e = VREF - HV*InputSignal(0,0);\ndouble u = Y3;\nint trava = (u > VSAT && e > 0.0) || (u < -VSAT && e < 0.0);\nContDeriv(0) = trava ? 0.0 : KC*e;\nContDeriv(1) = WP1*(Y1 - ContState(1));\nContDeriv(2) = WP2*(Y2 - ContState(2));" Show off } Parameter { Variable "UpdateFcn" Value "" Show off } Parameter { Variable "TerminateFcn" Value "" Show off } }
    Component { Type TriangleGenerator Name "Portadora_A" Show on Position [2900, 2670] Direction right Flipped off LabelPosition south Parameter { Variable "Min" Value "-Vd" Show off } Parameter { Variable "Max" Value "Vd" Show off } Parameter { Variable "f" Value "fs" Show off } Parameter { Variable "DutyCycle" Value "0.5" Show off } Parameter { Variable "Delay" Value "0" Show off } }
    Component { Type TriangleGenerator Name "Portadora_B" Show on Position [2900, 2910] Direction right Flipped off LabelPosition south Parameter { Variable "Min" Value "-Vd" Show off } Parameter { Variable "Max" Value "Vd" Show off } Parameter { Variable "f" Value "fs" Show off } Parameter { Variable "DutyCycle" Value "0.5" Show off } Parameter { Variable "Delay" Value "0.5/fs" Show off } }
